# Copy this file outside the repository as final_direct_rvp.env, edit the
# paths, then run: source /path/to/final_direct_rvp.env
# Do not commit the copied file: it contains machine-specific dataset paths.

# Repository and Python environment
export ROOT=/absolute/path/to/DROID-SLAM
export PYTHON=python

# EuRoC V1_03 strict-original-protocol assets.
# DATA_ROOT is the prepared camera directory containing data/ and frames.csv.
export DATA_ROOT=/absolute/path/to/V1_03_difficult_droid_cam0
export IMU_PRIOR=/absolute/path/to/V1_03_difficult/imu_prior_rectified_fd_jacobian.csv
export GT_CSV=/absolute/path/to/V1_03_difficult/mav0/state_groundtruth_estimate0/data.csv

# Weights.  Put the original DROID checkpoint and the released final learned
# checkpoint at any local paths; both are intentionally excluded from Git.
export ORIGINAL_WEIGHTS=/absolute/path/to/droid.pth
export LEARNED_WEIGHTS=/absolute/path/to/learned_attenuation_rvp_quality_pretrain_joint2000_001000.pth

# Fresh output directory.  The final evaluation script refuses to overwrite it.
export OUT_DIR=/absolute/path/to/results/final_v1_03_run

# Training-only paths, needed only by tools/run_final_direct_rvp_train.sh.
export TRAIN_DATA_ROOT=/absolute/path/to/euroc_stage3/raw
export MANIFEST_ROOT=/absolute/path/to/motion_filter_manifests_original_protocol
